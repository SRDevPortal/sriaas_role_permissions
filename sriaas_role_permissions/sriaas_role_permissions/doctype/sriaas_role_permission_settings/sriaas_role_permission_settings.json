  {
   "fieldname": "privacy_number_notes",
   "fieldtype": "HTML",
   "options": "<details class=\"role-settings-guide\"><summary>Permission Guide</summary><div class=\"alert alert-info\" role=\"note\" style=\"margin-bottom: 12px;\">\n<span class=\"badge badge-info\">Note</span>\n<strong style=\"margin-left: 6px;\">Phone and Mobile permissions</strong>\n<ul style=\"margin: 8px 0 0; padding-left: 20px;\">\n<li><strong>Role:</strong> Only users with at least one role listed in this table are subject to number masking. Users with no listed role see full numbers; this does not grant editing permissions.</li>\n<li><strong>View Full:</strong> Show complete stored Phone and Mobile numbers instead of masks.</li>\n<li><strong>Edit Existing:</strong> Correct or replace stored numbers. Does not automatically allow viewing full numbers.</li>\n<li><strong>New Patient Entry:</strong> Enter customer-provided numbers when registering a new Patient.</li>\n<li><strong>Add Number:</strong> Add a customer-provided contact number while keeping existing numbers.</li>\n<li><strong>Set Primary:</strong> Choose which contact number is the primary Mobile or Phone.</li>\n</ul>\n<p style=\"margin: 8px 0 0;\">Adding numbers or setting primary numbers does not reveal previously stored full numbers. Normal record permissions still apply.</p>\n</div></details>"
  },
